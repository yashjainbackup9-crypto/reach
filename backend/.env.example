# Database
MONGODB_URI=mongodb://localhost:27017/multi-tenant-system
DATABASE_NAME=multi-tenant-system

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Instagram / Facebook OAuth
# Create a Facebook Developer App at https://developers.facebook.com/apps
# Add the Instagram Basic Display or Instagram API product
# Required permissions: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
# Add INSTAGRAM_REDIRECT_URI to your app's Valid OAuth Redirect URIs in Facebook App Settings
INSTAGRAM_APP_ID=your_facebook_app_id
INSTAGRAM_APP_SECRET=your_facebook_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# API
PORT=3001
NODE_ENV=development

# Cron Settings
NEXT_SCHEDULE_DAYS=7
CRON_CHECK_INTERVAL=0 */5 * * * *

# AI Providers (fallback env keys — per-schedule keys can be set via API and are stored encrypted)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
# Which provider to use by default when a schedule has no aiConfig: anthropic | openai | gemini
DEFAULT_AI_PROVIDER=anthropic

# Encryption key for storing per-schedule API keys in the database
# Must be exactly 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Telegram Webhooks
# Public HTTPS URL this server is reachable at (no trailing slash)
# Telegram will POST updates to {TELEGRAM_WEBHOOK_BASE_URL}/api/telegram/webhook/{botToken}
TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.com
