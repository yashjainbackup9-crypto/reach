# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/multi-tenant-system
# Database name within the MongoDB instance
DATABASE_NAME=multi-tenant-system

# ─── Authentication ──────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — change in production
JWT_SECRET=your_jwt_secret_key_here
# How long JWT tokens stay valid (e.g., 7d, 24h, 30m)
JWT_EXPIRATION=7d

# ─── LinkedIn OAuth ──────────────────────────────────────────────────────────
# From LinkedIn Developer Portal > Your App > Auth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Must match the redirect URI configured in LinkedIn app settings
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# ─── Instagram / Facebook OAuth ─────────────────────────────────────────────
# From Facebook Developer Portal > Your App > Settings > Basic
# Required permissions: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
INSTAGRAM_APP_ID=your_facebook_app_id
INSTAGRAM_APP_SECRET=your_facebook_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the NestJS server listens on
PORT=3001
# Environment mode: development | production
NODE_ENV=development
# Frontend URL allowed by CORS — the Reach frontend origin
FRONTEND_URL=http://localhost:3000

# ─── Schedule Settings ──────────────────────────────────────────────────────
# How many days ahead to look when computing next schedule runs
NEXT_SCHEDULE_DAYS=7
# How often the built-in schedule checker runs (6-field cron, second precision)
CRON_CHECK_INTERVAL=0 */5 * * * *

# ─── AI Providers ───────────────────────────────────────────────────────────
# Fallback API keys — per-schedule keys can be set via API and stored encrypted
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
# Default AI provider when a schedule has no aiConfig: anthropic | openai | gemini
DEFAULT_AI_PROVIDER=anthropic

# ─── Encryption ─────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting API keys and headers stored in DB
# Must be exactly 64 hex characters (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ─── Telegram ───────────────────────────────────────────────────────────────
# Public HTTPS URL this server is reachable at (no trailing slash)
# Telegram POSTs updates to {TELEGRAM_WEBHOOK_BASE_URL}/api/telegram/webhook/{botToken}
TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.com

# ─── Comment-Automation Campaigns ───────────────────────────────────────────
# How often the campaign poller checks for new comments (6-field cron)
# Examples: "0 */2 * * * *" = every 2 min, "0 */10 * * * *" = every 10 min
CAMPAIGN_POLL_CRON=0 */5 * * * *

# ─── Meta Permissions (for Campaigns) ───────────────────────────────────────
# Instagram: instagram_manage_comments, instagram_manage_messages
# Facebook: pages_read_engagement, pages_manage_engagement, pages_messaging
# All require Live mode and may need Meta App Review
